#!/bin/bash
# Agents-only picker for herdr, sorted by priority (blocked > done > working > idle).
# Bound to prefix+a as a popup in ~/.config/herdr/config.toml.

workspaces=$(herdr workspace list)

selection=$(herdr agent list | jq -r --argjson ws "$workspaces" '
  ($ws.result.workspaces | map({(.workspace_id): .label}) | add) as $labels
  | {"blocked": 0, "done": 1, "working": 2, "idle": 3} as $rank
  | .result.agents
  | sort_by($rank[.agent_status] // 4, .workspace_id)
  | .[]
  | [.pane_id,
     .agent_status,
     ($labels[.workspace_id] // .workspace_id),
     .agent,
     (.terminal_title_stripped // "")]
  | @tsv' |
  column -t -s $'\t' |
  fzf --reverse --no-sort --no-input \
      --bind 'j:down,k:up,q:abort,l:accept,g:first,G:last' \
      --with-nth 2.. --preview 'herdr agent read {1} 2>/dev/null | tail -n 40' \
      --preview-window 'down,60%')

[ -z "$selection" ] && exit 0

# Focus after the popup has closed. herdr kills the popup's children, so run it
# as a transient systemd unit. Needs herdr server >= 0.9.1: older servers change
# focus without moving the attached client's view.
systemd-run --user --quiet --collect \
  --setenv=HERDR_SOCKET_PATH="$HERDR_SOCKET_PATH" \
  bash -c 'sleep 0.3; exec herdr agent focus "$1" > "${XDG_RUNTIME_DIR:-/tmp}/herdr-agents.log" 2>&1' _ "${selection%% *}"
